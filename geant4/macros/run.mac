# ============================================================
#  固定枪：y = 14 mm，沿 X–Z 平面对角线 45° 入射，
#  从左下角 (-41.5, -41.5) 射到右上角 (+41.5, +41.5)
#      ./build/pixel macros/run.mac   ->  pixel.root
#
#  几何参数在 src/DetectorConstruction.cc 文件开头的常量里
#  （kSide / kHeight / kN / kMaxStep / kGunAngle），这里只放能量、
#  事件数、输出名
# ============================================================

/run/initialize

/output/fileName  pixel.root
/gun/randomXY     false
/gun/energy       100 MeV

/random/setSeeds 12345 67890

/run/beamOn 5000
