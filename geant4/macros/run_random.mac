# ============================================================
#  随机枪：起点在入射面上均匀随机
#      x ∈ ±阵列半宽(41.5 mm)，y ∈ ±柱阵半高(20 mm)，z 固定，方向 45°
#      ./build/pixel macros/run_random.mac   ->  pixel_random.root
# ============================================================

/run/initialize

/output/fileName  pixel_random.root
/gun/randomXY     true
/gun/energy       100 MeV

/random/setSeeds 24680 13579

/run/beamOn 5000
